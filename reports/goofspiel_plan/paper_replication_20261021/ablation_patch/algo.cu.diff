+// Adam alternative (train.optimizer = 1): count the step on device so graphs replay it.
+__global__ void adam_count(int* step) { *step += 1; }
+
+// Global grad clip by L2, then Adam moments (beta1 = momentum) and the
+// bias-corrected update written back into the flat grad buffer.
+__global__ void adam_moments(float* __restrict__ mb, float* __restrict__ vb,
+        precision_t* __restrict__ gc, const float* __restrict__ sum_sq_ptr,
+        const int* __restrict__ step, float max_norm, float b1, float b2, int n) {
+    float clip_coef = fminf(max_norm / (sqrtf(*sum_sq_ptr) + 1e-6f), 1.0f);
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < n) {
+        float g = to_float(gc[idx]) * clip_coef;
+        float m = b1 * mb[idx] + (1.0f - b1) * g;
+        float v = b2 * vb[idx] + (1.0f - b2) * g * g;
+        mb[idx] = m; vb[idx] = v;
+        float t = (float)*step;
+        float mh = m / (1.0f - powf(b1, t)), vh = v / (1.0f - powf(b2, t));
+        gc[idx] = from_float(mh / (sqrtf(vh) + 1e-8f));
+    }
+}
