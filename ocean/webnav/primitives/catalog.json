      ],
      "limits": [
        "The response-v1 browser runner binds existing WF actions with 112 DOM and up to 16 host nodes. One scripted original-site NAVIGATE submission passes the official scorer; no learned or full-suite claim.",
        "Transport preset: 16384 data bytes, 2048 error-detail bytes, JSON depth at most 64."
      ],
      "operations": [
