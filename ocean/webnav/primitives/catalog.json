{
  "version": 1,
  "purpose": "Reusable simulator behavior units; MiniWoB task names are compatibility recipes, not primitive boundaries.",
  "runtime": "Stock CPU Bend for state, events and generation; C for transport/projection; existing C/CUDA learner.",
  "composition": "Controls compose page views. Views bind persistent records and drafts. Routes compose workflows. Domain engines supply application-specific state.",
  "identity": {
    "entity_id": "Persistent within an episode; independent of row position and DOM order.",
    "route_id": "Application-local page identity; resolved through public URLs/links.",
    "node_ref": "Ephemeral observation/action reference; stale refs reject without mutation.",
    "history_entry": "Route plus view query, pagination, scroll and focus state; restoration policy is versioned.",
    "draft_id": "Editable working state; isolated from committed records until commit."
  },
  "layers": [
    {
      "name": "controls",
      "meaning": "Observable widgets and their local input behavior; role, enabled state, focus, selection and gestures."
    },
    {
      "name": "page",
      "meaning": "Control layout, public relationships, routing, history, loading and errors."
    },
    {
      "name": "data",
      "meaning": "Persistent entities, queries, relationships, working drafts and atomic commits."
    },
    {
      "name": "workflow",
      "meaning": "Application rules and goals composed from the lower layers; no task-name dispatch in the policy."
    }
  ],
  "primitives": [
    {
      "id": "control_activation",
      "layer": "controls",
      "status": "extract_from_existing",
      "sources": [
        "../miniwob/Widgets.bend"
      ],
