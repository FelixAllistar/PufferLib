// GPU Retro (SMB-lite) — massively parallel, minimal overhead.
// Requires -DPUFFER_GPU_ENV (build with --gpu). SOA-friendly, AoS Env variant
// to keep pufferl vec interface simple. Level colliders are baked host-side
// and uploaded once via single cudaMemcpy; per-env mutable state is compact.
//
// Design for thousands of envs:
//   * Env struct ~64 bytes (Log first). 8k envs = ~512KB.
//   * Level collider templates: host generates 32 levels × 256×16 bytes = 131KB,
//     uploaded to global device buffer d_templates (not __constant__ due to 64KB limit).
//   * Per-env mutable tiles: SoA buffer d_env_tiles [total_agents * W*H] (~4KB per env).
//     Could be compressed to bitsets (TODO), but full byte per tile keeps sampling cheap.
//   * Observations: coop multi-lane coalesced write (like breakout.cu) avoids 80% of time
//     being spent in obs AoS stores.

#ifndef PUFFER_RETRO_GPU_CU
#define PUFFER_RETRO_GPU_CU
#ifndef PUFFER_GPU_ENV
#error "retro.cu requires -DPUFFER_GPU_ENV (build with --gpu)"
#endif

// OBS_SIZE, NUM_ATNS etc come from retro.h (ENV_HEADER)
#define RETRO_THREADS_PER_ENV 16
#ifndef RETRO_MAX_LEVELS
#define RETRO_MAX_LEVELS 32
#endif

// Shared config (constant memory)
typedef struct RetroConfig {
    int level_w;
    int level_h;
    int max_levels;
    int frameskip;
    float gravity;
    float max_vx;
    float jump_v;
    float run_accel;
    float friction;
} RetroConfig;

__constant__ RetroConfig d_rcfg;

// Global level templates + per-env mutable tiles (SoA, outside Env AoS)
static unsigned char* d_templates = NULL;   // [MAX_LEVELS * H*W] bytes
static unsigned char* d_env_tiles = NULL;   // [total_agents * H*W] bytes
static int g_total_agents = 0;

// Per-env dynamic state only. Log first for parallel reduce.
typedef struct Env {
    Log log;
    float mario_x, mario_y;
    float mario_vx, mario_vy;
    int   mario_dir;
    int   on_ground;
    int   powerup;
    int   coins;
    int   score;
    int   tick;
    int   scroll_x;
    int   max_scroll;
    int   level_id;
    int   has_flag;
    int   is_dead;
    unsigned int rng;
} Env;

// ---- helpers ----

__device__ __forceinline__ void retro_store_obs(obs_t* dst, float v) {
#if defined(from_float)
    *dst = from_float(v);
#else
    *dst = v;
#endif
}

__device__ static inline unsigned int retro_xorshift(unsigned int* s) {
    unsigned int x = *s;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    *s = x ? x : 0xA341316Cu;
    return *s;
}

__device__ static inline unsigned char retro_sample_tile_device(int env_idx, int tx, int ty) {
    if (tx < 0 || tx >= d_rcfg.level_w || ty < 0 || ty >= d_rcfg.level_h) return RETRO_TILE_EMPTY;
    int W = d_rcfg.level_w;
    int H = d_rcfg.level_h;
    // per-env mutable tiles take precedence; templates are fallback for initial
    // But d_env_tiles already holds the current mutable copy, so use it directly.
    long off = (long)env_idx * (W*H) + (long)ty * W + tx;
    return d_env_tiles[off];
}

__device__ static inline unsigned char retro_sample_tile_template(int level_id, int tx, int ty) {
    if (tx < 0 || tx >= d_rcfg.level_w || ty < 0 || ty >= d_rcfg.level_h) return RETRO_TILE_EMPTY;
    int W = d_rcfg.level_w;
    long off = (long)level_id * (W * d_rcfg.level_h) + (long)ty * W + tx;
    return d_templates[off];
}

__device__ static inline int retro_is_solid(unsigned char t) {
    return t==RETRO_TILE_SOLID || t==RETRO_TILE_BRICK || t==RETRO_TILE_QUESTION || t==RETRO_TILE_PIPE;
}

// ---- observations ----

// Single-thread version (reset path)
__device__ static inline void retro_compute_obs_single(const Env* env, int env_idx, obs_t* obs) {
    float mx = env->mario_x;
    float my = env->mario_y;
    int W = d_rcfg.level_w;
    int H = d_rcfg.level_h;
    retro_store_obs(&obs[0],  mx / (float)W);
    retro_store_obs(&obs[1],  my / (float)H);
    retro_store_obs(&obs[2],  env->mario_vx / 4.0f);
    retro_store_obs(&obs[3],  env->mario_vy / 6.0f);
    retro_store_obs(&obs[4],  env->on_ground ? 1.0f : 0.0f);
    retro_store_obs(&obs[5],  env->mario_dir > 0 ? 1.0f : -1.0f);
    retro_store_obs(&obs[6],  (float)env->powerup / 2.0f);
    retro_store_obs(&obs[7],  (float)env->coins / 50.0f);
    retro_store_obs(&obs[8],  fminf((float)env->score / 10000.0f, 1.0f));
    retro_store_obs(&obs[9],  env->tick / 5000.0f);
    retro_store_obs(&obs[10], 1.0f); // world
    retro_store_obs(&obs[11], 1.0f); // level
    retro_store_obs(&obs[12], env->scroll_x / (float)W);
    retro_store_obs(&obs[13], (mx - env->scroll_x) / 16.0f);
    retro_store_obs(&obs[14], env->has_flag ? 1.0f : 0.0f);
    retro_store_obs(&obs[15], env->is_dead ? 1.0f : 0.0f);

    int cx = (int)floorf(mx);
    int cy = (int)floorf(my);
    int idx = RETRO_EGO_SIZE;
    for (int dy = -RETRO_WINDOW_RADIUS_H; dy < RETRO_WINDOW_H - RETRO_WINDOW_RADIUS_H; dy++) {
        for (int dx = -RETRO_WINDOW_RADIUS_W; dx < RETRO_WINDOW_W - RETRO_WINDOW_RADIUS_W; dx++) {
            int tx = cx + dx;
            int ty = cy + dy;
            unsigned char t = retro_sample_tile_device(env_idx, tx, ty);
            retro_store_obs(&obs[idx++], t / 9.0f);
        }
    }
}

// Coop version: lane in [0, nlanes)
__device__ static inline void retro_compute_obs_coop(const Env* env, int env_idx, obs_t* obs, int lane, int nlanes) {
    int W = d_rcfg.level_w;
    int H = d_rcfg.level_h;
    float mx = env->mario_x;
    float my = env->mario_y;

    if (lane < RETRO_EGO_SIZE) {
        float v;
        switch (lane) {
            case 0: v = mx / (float)W; break;
            case 1: v = my / (float)H; break;
            case 2: v = env->mario_vx / 4.0f; break;
            case 3: v = env->mario_vy / 6.0f; break;
            case 4: v = env->on_ground ? 1.0f : 0.0f; break;
            case 5: v = env->mario_dir > 0 ? 1.0f : -1.0f; break;
            case 6: v = (float)env->powerup / 2.0f; break;
            case 7: v = (float)env->coins / 50.0f; break;
            case 8: v = fminf((float)env->score / 10000.0f, 1.0f); break;
            case 9: v = env->tick / 5000.0f; break;
            case 10: v = 1.0f; break;
            case 11: v = 1.0f; break;
            case 12: v = env->scroll_x / (float)W; break;
            case 13: v = (mx - env->scroll_x) / 16.0f; break;
            case 14: v = env->has_flag ? 1.0f : 0.0f; break;
            default: v = env->is_dead ? 1.0f : 0.0f; break;
        }
        retro_store_obs(&obs[lane], v);
    }
    // Tiles: STRIDE over W*H window. Lanes cooperatively fill 144 tiles.
    int cx = (int)floorf(mx);
    int cy = (int)floorf(my);
    int total = RETRO_TILES;
    // Each lane handles indices lane, lane+nlanes, ...
    // Need to map linear idx -> (dx,dy)
    for (int li = lane; li < total; li += nlanes) {
        int dy = (li / RETRO_WINDOW_W) - RETRO_WINDOW_RADIUS_H;
        int dx = (li % RETRO_WINDOW_W) - RETRO_WINDOW_RADIUS_W;
        int tx = cx + dx;
        int ty = cy + dy;
        unsigned char t = retro_sample_tile_device(env_idx, tx, ty);
        retro_store_obs(&obs[RETRO_EGO_SIZE + li], t / 9.0f);
    }
}

// ---- level generation (device side uses templates; host fills them) ----

__host__ static void retro_host_generate_level(unsigned char* tiles, int W, int H, unsigned int seed) {
    memset(tiles, RETRO_TILE_EMPTY, (size_t)W*H);
    for (int x=0;x<W;x++) { tiles[(H-2)*W + x]=RETRO_TILE_SOLID; tiles[(H-1)*W + x]=RETRO_TILE_SOLID; }
    unsigned int rng = seed ? seed : 1;
    #define RND() (rng = rng*1103515245u + 12345u, (rng>>16)&0x7fffu)
    for (int i=0;i<18;i++) {
        int px = 12 + (RND()% (W-24));
        int py = 3 + (RND()% (H-6));
        int pw = 3 + (RND()%5);
        for (int dx=0;dx<pw;dx++) { int x=px+dx; if (x>=0&&x<W) tiles[py*W+x]=RETRO_TILE_SOLID; }
    }
    for (int i=0;i<24;i++) {
        int x = 8 + (RND()% (W-16));
        int y = 2 + (RND()% (H-5));
        unsigned char t=(RND()%3==0)?RETRO_TILE_QUESTION:RETRO_TILE_BRICK;
        tiles[y*W+x]=t;
        if ((RND()%4)==0 && y+1<H) tiles[(y+1)*W+x]=RETRO_TILE_COIN;
    }
    for (int i=0;i<3;i++) {
        int px=40+i*60+(RND()%10); int ph=2+(RND()%3);
        for (int dy=0;dy<ph;dy++) for(int dx=0;dx<2;dx++){int x=px+dx,y=H-2-dy-1; if(x<W&&y>=0) tiles[y*W+x]=RETRO_TILE_PIPE;}
    }
    for(int i=0;i<8;i++){int x=20+(RND()%(W-30)); int y=H-3; tiles[y*W+x]=RETRO_TILE_ENEMY;}
    for(int y=2;y<H-2;y++) tiles[y*W+(W-4)]=RETRO_TILE_FLAG;
    #undef RND
}

// ---- physics (mirrors CPU retro_step_physics) ----

__device__ static inline void retro_apply_reward_device(Env* env, float* reward, float r) {
    *reward += r;
    env->score += (int)(r*10);
}

__device__ static inline void retro_step_physics_device(Env* env, int env_idx, unsigned char joy, float* reward, float* terminal) {
    int right = (joy & RETRO_BTN_RIGHT) != 0;
    int left  = (joy & RETRO_BTN_LEFT) != 0;
    int btn_a = (joy & RETRO_BTN_A) != 0;
    int btn_b = (joy & RETRO_BTN_B) != 0;
    int down  = (joy & RETRO_BTN_DOWN) != 0;

    float accel = d_rcfg.run_accel * (btn_b ? 1.6f : 1.0f);
    float maxvx = d_rcfg.max_vx * (btn_b ? 1.45f : 1.0f);

    if (right && !left) { env->mario_vx += accel; env->mario_dir = 1; }
    else if (left && !right) { env->mario_vx -= accel; env->mario_dir = -1; }
    else { env->mario_vx *= d_rcfg.friction; if (fabsf(env->mario_vx) < 0.02f) env->mario_vx=0; }
    if (env->mario_vx > maxvx) env->mario_vx = maxvx;
    if (env->mario_vx < -maxvx) env->mario_vx = -maxvx;

    if (btn_a && env->on_ground) { env->mario_vy = d_rcfg.jump_v * (btn_b ? 1.1f : 1.0f); env->on_ground = 0; }
    float g = d_rcfg.gravity;
    if (!btn_a && env->mario_vy < 0) g *= 1.6f;
    env->mario_vy += g * 0.16f;
    if (env->mario_vy > 6.0f) env->mario_vy = 6.0f;

    // Horizontal
    float nx = env->mario_x + env->mario_vx * 0.28f;
    int tx = (int)floorf(nx);
    // test body at two heights
    int y0 = (int)floorf(env->mario_y+0.2f);
    int y1 = (int)floorf(env->mario_y+0.6f);
    unsigned char c0 = retro_sample_tile_device(env_idx, tx, y0);
    unsigned char c1 = retro_sample_tile_device(env_idx, tx, y1);
    if (retro_is_solid(c0) || retro_is_solid(c1)) {
        nx = env->mario_x;
        env->mario_vx = 0;
    }
    env->mario_x = nx;
    if (env->mario_x < 0.5f) env->mario_x = 0.5f;
    if (env->mario_x > d_rcfg.level_w - 1.5f) env->mario_x = d_rcfg.level_w - 1.5f;

    // Vertical
    float ny = env->mario_y + env->mario_vy * 0.28f;
    int vy_ty = (int)floorf(ny + 0.8f);
    int vx_tx = (int)floorf(env->mario_x);
    unsigned char below = retro_sample_tile_device(env_idx, vx_tx, vy_ty);
    unsigned char above = retro_sample_tile_device(env_idx, vx_tx, (int)floorf(ny));

    if (env->mario_vy > 0) {
        if (retro_is_solid(below)) {
            env->mario_y = (float)vy_ty - 0.81f;
            env->mario_vy = 0;
            env->on_ground = 1;
        } else { env->mario_y = ny; env->on_ground = 0; }
    } else if (env->mario_vy < 0) {
        if (retro_is_solid(above)) {
            int hit_y = (int)floorf(ny);
            unsigned char hit = retro_sample_tile_device(env_idx, vx_tx, hit_y);
            if (hit == RETRO_TILE_BRICK) {
                if (env->powerup > 0) {
                    long off = (long)env_idx * (d_rcfg.level_w*d_rcfg.level_h) + (long)hit_y*d_rcfg.level_w + vx_tx;
                    d_env_tiles[off] = RETRO_TILE_EMPTY;
                    retro_apply_reward_device(env, reward, 1.0f);
                } else {
                    env->mario_vy = 1.0f;
                }
            } else if (hit == RETRO_TILE_QUESTION) {
                long off = (long)env_idx * (d_rcfg.level_w*d_rcfg.level_h) + (long)hit_y*d_rcfg.level_w + vx_tx;
                d_env_tiles[off] = RETRO_TILE_EMPTY;
                env->coins += 1;
                retro_apply_reward_device(env, reward, 0.5f);
            }
            env->mario_y = (float)(hit_y + 1) + 0.01f;
            env->mario_vy = 0;
        } else { env->mario_y = ny; }
    } else {
        unsigned char under = retro_sample_tile_device(env_idx, vx_tx, (int)floorf(env->mario_y+0.9f));
        env->on_ground = retro_is_solid(under);
    }

    if (env->mario_y < 0) { env->mario_y=0; env->mario_vy=0; }
    if (env->mario_y > d_rcfg.level_h - 1) {
        env->is_dead = 1;
    }

    int target_scroll = (int)(env->mario_x - 6);
    if (target_scroll > env->scroll_x) env->scroll_x = target_scroll;
    if (env->scroll_x < 0) env->scroll_x = 0;
    int max_sx = d_rcfg.level_w - 16;
    if (env->scroll_x > max_sx) env->scroll_x = max_sx;
    if (env->scroll_x > env->max_scroll) env->max_scroll = env->scroll_x;

    int mtx = (int)floorf(env->mario_x);
    int mty = (int)floorf(env->mario_y+0.5f);
    unsigned char cur = retro_sample_tile_device(env_idx, mtx, mty);
    unsigned char cur_feet = retro_sample_tile_device(env_idx, mtx, (int)floorf(env->mario_y+0.8f));
    // coin
    int coin_found = 0;
    int coin_x=-1, coin_y=-1;
    if (cur == RETRO_TILE_COIN) { coin_found=1; coin_x=mtx; coin_y=mty; }
    else if (cur_feet == RETRO_TILE_COIN) { coin_found=1; coin_x=mtx; coin_y=(int)floorf(env->mario_y+0.8f); }
    if (coin_found) {
        long off = (long)env_idx*(d_rcfg.level_w*d_rcfg.level_h)+(long)coin_y*d_rcfg.level_w+coin_x;
        d_env_tiles[off]=RETRO_TILE_EMPTY;
        env->coins+=1;
        retro_apply_reward_device(env, reward, 0.2f);
    }
    // enemy
    int enemy_found=0; int ex=-1, ey=-1;
    if (cur==RETRO_TILE_ENEMY) { enemy_found=1; ex=mtx; ey=mty; }
    else if (cur_feet==RETRO_TILE_ENEMY){enemy_found=1; ex=mtx; ey=(int)floorf(env->mario_y+0.8f);}
    if (enemy_found) {
        if (env->mario_vy > 0.5f) {
            long off=(long)env_idx*(d_rcfg.level_w*d_rcfg.level_h)+(long)ey*d_rcfg.level_w+ex;
            d_env_tiles[off]=RETRO_TILE_EMPTY;
            env->mario_vy = d_rcfg.jump_v * 0.6f;
            retro_apply_reward_device(env, reward, 1.0f);
        } else {
            if (env->powerup>0) { env->powerup--; env->mario_vy=-2.0f; }
            else { env->is_dead=1; }
        }
    }
    if (cur==RETRO_TILE_FLAG || cur_feet==RETRO_TILE_FLAG) {
        env->has_flag=1;
        retro_apply_reward_device(env, reward, 10.0f);
        *terminal = 1.0f;
        return;
    }
    if (down && (cur==RETRO_TILE_PIPE || cur_feet==RETRO_TILE_PIPE)) {
        retro_apply_reward_device(env, reward, 0.1f);
        env->mario_x += 8.0f;
        if (env->mario_x > d_rcfg.level_w-2) env->mario_x = d_rcfg.level_w-2;
    }
    if (env->is_dead) { *terminal = 1.0f; return; }
    // small forward progress (use scroll delta approximation)
    if (env->mario_vx > 0) retro_apply_reward_device(env, reward, env->mario_vx*0.0002f);
}

__device__ static inline void retro_reset_state_device(Env* env, int env_idx) {
    env->tick = 0;
    env->scroll_x = 0;
    env->max_scroll = 0;
    env->has_flag = 0;
    env->is_dead = 0;
    env->coins = 0;
    env->score = 0;
    env->mario_x = 2.0f;
    env->mario_y = (float)(d_rcfg.level_h - 3) - 0.1f;
    env->mario_vx = 0; env->mario_vy = 0;
    env->mario_dir = 1;
    env->on_ground = 1;
    env->powerup = 0;
    // pick next level
    env->level_id = (int)(retro_xorshift(&env->rng) % d_rcfg.max_levels);
    // copy template for this level into per-env mutable buffer
    int W = d_rcfg.level_w, H = d_rcfg.level_h;
    long off_env = (long)env_idx * (W*H);
    long off_tpl = (long)env->level_id * (W*H);
    // cooperative copy would be faster with multiple lanes, but reset is rare;
    // single-thread memcpy here is okay (only lane 0 calls it).
    for (int i=0;i<W*H;i++) d_env_tiles[off_env + i] = d_templates[off_tpl + i];
}

__device__ static inline void retro_add_log(Env* env) {
    // perf = progress or 1 if flagged
    float prog = env->max_scroll / (float)(d_rcfg.level_w - 16);
    if (prog>1) prog=1;
    if (env->has_flag) prog=1.0f;
    env->log.perf += prog;
    env->log.score += env->score;
    env->log.episode_return += 0; // filled via rewards? keep as-is; pufferl aggregates externally too
    env->log.episode_length += env->tick;
    env->log.distance += env->max_scroll;
    env->log.flag += env->has_flag ? 1:0;
    env->log.deaths += env->is_dead ? 1:0;
    env->log.coins += env->coins;
    env->log.n += 1.0f;
}

// ---- kernels ----

__global__ void retro_reset_kernel(Env* envs, obs_t* observations, float* rewards, float* terminals, int num_envs) {
    int thr = blockIdx.x * blockDim.x + threadIdx.x;
    int rel = thr / RETRO_THREADS_PER_ENV;
    int lane = thr - rel * RETRO_THREADS_PER_ENV;
    int active = rel < num_envs;

    if (active && lane == 0) {
        Env* e = &envs[rel];
        retro_reset_state_device(e, rel);
        rewards[rel] = 0.0f;
        terminals[rel] = 0.0f;
    }
    __syncwarp();
    if (active) {
        retro_compute_obs_coop(&envs[rel], rel, observations + (long)rel * OBS_SIZE, lane, RETRO_THREADS_PER_ENV);
    }
}

__global__ void retro_step_kernel(Env* __restrict__ envs,
        const float* __restrict__ actions, obs_t* __restrict__ observations,
        float* __restrict__ rewards, float* __restrict__ terminals,
        int start, int count) {
    int thr = blockIdx.x * blockDim.x + threadIdx.x;
    int rel = thr / RETRO_THREADS_PER_ENV;
    int lane = thr - rel * RETRO_THREADS_PER_ENV;
    int active = rel < count;
    int idx = start + rel;

    if (active && lane == 0) {
        Env* env = &envs[idx];
        // Decode discrete action -> joy mask via lookup table baked into kernel as switch
        int act = (int)actions[(long)idx * NUM_ATNS];
        if (act < 0) act = 0;
        if (act >= RETRO_NUM_ACTIONS) act = RETRO_NUM_ACTIONS-1;
        // Use same table as host: define locally to avoid global memory fetch
        const unsigned char tbl[RETRO_NUM_ACTIONS] = {
            0,
            RETRO_BTN_RIGHT,
            RETRO_BTN_RIGHT|RETRO_BTN_A,
            RETRO_BTN_RIGHT|RETRO_BTN_B,
            RETRO_BTN_RIGHT|RETRO_BTN_A|RETRO_BTN_B,
            RETRO_BTN_A,
            RETRO_BTN_LEFT,
            RETRO_BTN_LEFT|RETRO_BTN_A,
            RETRO_BTN_DOWN,
            RETRO_BTN_B,
            RETRO_BTN_UP,
            RETRO_BTN_RIGHT|RETRO_BTN_DOWN
        };
        unsigned char joy = tbl[act];
        float reward = 0.0f;
        float terminal = 0.0f;
        int fs = d_rcfg.frameskip;
        for (int i=0;i<fs;i++) {
            env->tick++;
            if (terminal != 0) break;
            retro_step_physics_device(env, idx, joy, &reward, &terminal);
            if (env->tick > 5000) { terminal = 1.0f; break; }
        }
        if (terminal != 0) {
            retro_add_log(env);
            retro_reset_state_device(env, idx);
            // keep the rewards/terminal of the step that caused Done (like breakout)
            // next obs will be from fresh state
        }
        rewards[idx] = reward;
        terminals[idx] = terminal;
    }
    __syncwarp();
    if (active) {
        retro_compute_obs_coop(&envs[idx], idx, observations + (long)idx * OBS_SIZE, lane, RETRO_THREADS_PER_ENV);
    }
}

// ---- host create / reset / step ----

static void retro_host_fill_config(RetroConfig* cfg, Dict* kwargs) {
    memset(cfg,0,sizeof(*cfg));
    // required keys from retro.ini with fallbacks
    DictItem* it;
    it = dict_find(kwargs, "frameskip"); cfg->frameskip = it? (int)it->value : 4;
    it = dict_find(kwargs, "gravity");   cfg->gravity   = it? (float)it->value : 0.52f;
    it = dict_find(kwargs, "max_vx");    cfg->max_vx    = it? (float)it->value : 2.8f;
    it = dict_find(kwargs, "jump_v");    cfg->jump_v    = it? (float)it->value : -6.2f;
    it = dict_find(kwargs, "run_accel"); cfg->run_accel = it? (float)it->value : 0.22f;
    it = dict_find(kwargs, "friction");  cfg->friction  = it? (float)it->value : 0.88f;
    cfg->level_w = 256;
    cfg->level_h = 16;
    cfg->max_levels = RETRO_MAX_LEVELS;
}

static Env* puf_envs_create(int total_agents, Dict* env_kwargs) {
    RetroConfig cfg;
    retro_host_fill_config(&cfg, env_kwargs);
    cudaMemcpyToSymbol(d_rcfg, &cfg, sizeof(RetroConfig));

    // Allocate level templates on host, then upload
    int W=cfg.level_w, H=cfg.level_h, L=cfg.max_levels;
    size_t tmpl_bytes = (size_t)L * W * H;
    unsigned char* h_templates = (unsigned char*)malloc(tmpl_bytes);

    // Optional: if rom_path provided, try parse iNES and decode SMB levels.
    // For now, procedural fallback with per-level seed. A full parser would
    // replace this block with real ROM decoding.
    const char* rom_path = NULL;
    DictItem* rp = dict_find(env_kwargs, "rom_path");
    if (rp && rp->str) rom_path = rp->str;
    bool have_rom = false;
    if (rom_path && rom_path[0]) {
        FILE* f = fopen(rom_path, "rb");
        if (f) {
            unsigned char hdr[16];
            if (fread(hdr,1,16,f)==16 && hdr[0]=='N'&&hdr[1]=='E'&&hdr[2]=='S') {
                fprintf(stderr, "[retro gpu] ROM detected at %s (procedural fallback for now; template is synthetic)\n", rom_path);
                have_rom = true;
            }
            fclose(f);
        } else {
            // Try WSL translation: C:/ -> /mnt/c/
            if (rom_path[1]==':' && (rom_path[2]=='/'||rom_path[2]=='\\')) {
                char alt[1024];
                snprintf(alt,sizeof(alt),"/mnt/%c/%s", tolower(rom_path[0]), rom_path+3);
                for(char*p=alt;*p;p++) if(*p=='\\') *p='/';
                FILE* f2=fopen(alt,"rb");
                if(f2){ fprintf(stderr,"[retro gpu] ROM found via WSL translate: %s\n",alt); have_rom=true; fclose(f2); }
            }
        }
    }

    // Procedural levels (fast, no file IO). If have_rom, we could in future
    // parse real levels here with a single host pass; still upload once.
    for (int l=0;l<L;l++) {
        unsigned int seed = (unsigned int)(0x9e3779b1u * (l+1) + 0x12345u + (have_rom? 0xdeadbeefu:0));
        retro_host_generate_level(h_templates + (size_t)l*W*H, W, H, seed);
    }

    cudaMalloc((void**)&d_templates, tmpl_bytes);
    cudaMemcpy(d_templates, h_templates, tmpl_bytes, cudaMemcpyHostToDevice);
    free(h_templates);

    // Per-env mutable tiles
    size_t env_tiles_bytes = (size_t)total_agents * W * H;
    cudaMalloc((void**)&d_env_tiles, env_tiles_bytes);
    // Initialize per-env tiles lazily in reset kernel via template copy, but need valid memory
    cudaMemset(d_env_tiles, 0, env_tiles_bytes);

    // Env array
    Env* host_envs = (Env*)calloc((size_t)total_agents, sizeof(Env));
    for (int i=0;i<total_agents;i++) {
        host_envs[i].rng = (unsigned int)(i* 0x9e3779b1u + 1);
        host_envs[i].level_id = i % L;
    }
    Env* envs = NULL;
    cudaMalloc((void**)&envs, (size_t)total_agents * sizeof(Env));
    cudaMemcpy(envs, host_envs, (size_t)total_agents*sizeof(Env), cudaMemcpyHostToDevice);
    free(host_envs);
    g_total_agents = total_agents;

    // Pre-copy templates into per-env buffers for any kernels that assume
    // d_env_tiles already initialized (optional). The reset kernel will overwrite.
    // Do it here on host via device copy loop to avoid uninitialized reads before first reset:
    // We just launch a one-off kernel to init.

    return envs;
}

static void puf_envs_reset(Env* envs, obs_t* observations, float* rewards, float* terminals, int total_agents) {
    int threads = total_agents * RETRO_THREADS_PER_ENV;
    retro_reset_kernel<<<grid_size(threads), BLOCK_SIZE>>>(envs, observations, rewards, terminals, total_agents);
}

static void puf_envs_step(Env* envs, const float* actions, obs_t* observations,
        float* rewards, float* terminals, int start, int count, cudaStream_t stream) {
    int threads = count * RETRO_THREADS_PER_ENV;
    retro_step_kernel<<<grid_size(threads), BLOCK_SIZE, 0, stream>>>(envs, actions, observations, rewards, terminals, start, count);
}

static void puf_envs_close(Env* envs) {
    if (d_templates) cudaFree(d_templates);
    if (d_env_tiles) cudaFree(d_env_tiles);
    d_templates = NULL; d_env_tiles = NULL;
    cudaFree(envs);
}

void puf_render(Env* env) { (void)env; }

#endif
