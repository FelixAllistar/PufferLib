[base]
env_name = retro
async = 1

[vec]
total_agents = 4096
num_buffers = 1
num_threads = 8
gpu_env = 0

[policy]
num_layers = 4
hidden_size = 128

[env]
frameskip = 4
core_path = ocean/retro/cores/quicknes_libretro.so
rom_path = ocean/retro/roms/smb1.nes
gravity = 0.52
max_vx = 2.8
jump_v = -6.2
run_accel = 0.22
friction = 0.88

[train]
total_timesteps = 100_000_000
learning_rate = 0.0003
gamma = 0.99
gae_lambda = 0.95
replay_ratio = 2
clip_coef = 0.2
vf_coef = 0.5
vf_clip_coef = 0.2
max_grad_norm = 0.5
ent_coef = 0.01
momentum = 0.9
minibatch_size = 32768
horizon = 32
prio_alpha = 0
prio_beta0 = 0.6
vtrace_c_clip = 1.0
vtrace_rho_clip = 1.0
