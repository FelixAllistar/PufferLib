[base]
env_name = poker
seed = 73
checkpoint_interval = 0
# gen0 league sweep: every trial warm-starts from gen0 (the magnet starts there too).
load_model_path = leagues/poker/gen0/gen0.bin
async = 1
cudagraphs = 1

[vec]
total_agents = 16384
num_buffers = 2
num_threads = 4
num_policies = 1
hist_policy_percent = 0

[policy]
architecture = puffernet
hidden_size = 128
num_layers = 3

[env]
num_agents = 1
num_players = 6
starting_stack = 20000
bot_policy = 7
# Active IDs: 1 rules control, 4 Fullhouse, 7 range. Zero uses bot_policy;
# otherwise bit i enables policy i once per seat. 146 mixes all three.
native_baseline_mask = 0
# 0 uses the build default. 32, 64 and 128 choose the range sampling budget.
equity_samples = 0
# Public table statistics persist across hands; only the range policy uses them.
native_history = 0
seed = 73
# gen0 league: each opponent seat is the range bot (bot_policy 7) with probability rules_fraction,
# otherwise gen0 (leagues/poker/gen0). Frozen opponents run on CPU, so all trainer rows are learner rows.
native_league = leagues/poker/gen0/opponents.txt
# 1: league seats run as one batched GPU forward per round (ocean/poker/poker.h); 0: inline on CPU.
league_gpu = 1
rules_fraction = 0.25

[selfplay]
# Native acting-opponent banks are frozen per stint by ocean/poker/league.py.
# Keep the trainer's simultaneous-row selfplay pool off for this adapter.
enabled = 0

[train]
# gen0 league sweep (2026-10-23): trial 0 is the 1B gen0 recipe (mega-sweep trial 99, LR/entropy/magnet
# annealing on) continued from gen0 for 30M steps against gen0 + range bots. The 1B config is saved as
# leagues/poker/gen0/gen0_train_config.ini.
total_timesteps = 30000000
anneal_lr = 1
learning_rate = 0.003
gamma = 0.95
gae_lambda = 0.989157677
reward_clip = 0
horizon = 16
minibatch_size = 1024
replay_ratio = 1.45144784
clip_coef = 0.391240656
vf_clip_coef = 0.938034117
vf_coef = 0.275439382
max_grad_norm = 0.25
momentum = 0.940657675
ent_coef = 0.000145730155
anneal_ent_coef = 1
min_ent_coef_ratio = 0.01
magnet_coef = 0.0128853433
magnet_tau = 0.00130456768
magnet_reverse = 1
anneal_magnet_coef = 1
[sweep]
metric = score
goal = maximize
max_runs = 1000
downsample = 1
max_suggestion_cost = 3600
history_path = None

# --- searched (ranges widened 2026-10-23 where the mega sweep's best trials sat on a bound) ---
[sweep.train.learning_rate]
distribution = log_normal
min = 0.00003
max = 0.003
scale = auto

[sweep.train.ent_coef]
distribution = log_normal
min = 0.00001
max = 0.1
scale = auto

[sweep.train.anneal_ent_coef]
distribution = int_uniform
min = 0
max = 1
scale = auto

[sweep.train.min_ent_coef_ratio]
distribution = log_normal
min = 0.001
max = 1
scale = auto

[sweep.train.clip_coef]
distribution = uniform
min = 0.05
max = 0.6
scale = auto

[sweep.train.vf_coef]
distribution = log_normal
min = 0.1
max = 2
scale = auto

[sweep.train.gae_lambda]
distribution = logit_normal
min = 0.8
max = 0.995
scale = auto

[sweep.train.replay_ratio]
distribution = uniform
min = 1
max = 4
scale = auto

[sweep.train.max_grad_norm]
distribution = log_normal
min = 0.1
max = 3
scale = auto

# Pinned: every trial loads gen0 (128x3), so the learner must match its shape.
[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 128
max = 128
scale = auto

[sweep.policy.num_layers]
distribution = int_uniform
min = 3
max = 3
scale = auto

# --- also searched (ranges keep every batch layout valid: agents*horizon >= max minibatch) ---
[sweep.train.gamma]
distribution = uniform
min = 0.9
max = 1.0
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 4096
max = 16384
scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 8
max = 64
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 512
max = 16384
scale = auto

[sweep.train.vf_clip_coef]
distribution = log_normal
min = 0.05
max = 2
scale = auto

[sweep.train.momentum]
distribution = logit_normal
min = 0.8
max = 0.99
scale = auto

# --- EMAgnet (magnet KL toward an EMA of the learner) ---
[sweep.train.magnet_coef]
distribution = log_normal
min = 0.001
max = 1
scale = auto

[sweep.train.magnet_tau]
distribution = log_normal
min = 0.0001
max = 0.1
scale = auto

[sweep.train.magnet_reverse]
distribution = int_uniform
min = 0
max = 1
scale = auto

[sweep.train.anneal_magnet_coef]
distribution = int_uniform
min = 0
max = 1
scale = auto

# --- fixed budget (min = max must equal [train] total_timesteps) ---
[sweep.train.total_timesteps]
distribution = log_normal
min = 10000000
max = 100000000
scale = auto


